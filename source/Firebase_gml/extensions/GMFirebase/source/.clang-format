# Style of the hand-written native code under src/native: tabs, Allman braces
# everywhere (functions, control statements, lambdas, else and catch), case
# labels at the switch's indent, one statement per line, the original line
# breaks kept (no column limit). Needs clang-format 17 or newer. Nothing under
# code_gen/ is ever formatted.
Language: Cpp
Standard: c++17
BasedOnStyle: LLVM
ColumnLimit: 0
UseTab: ForContinuationAndIndentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Leave
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignEscapedNewlines: DontAlign
PointerAlignment: Left
ReferenceAlignment: Pointer
QualifierAlignment: Leave
IndentCaseLabels: false
IndentCaseBlocks: false
IndentPPDirectives: None
NamespaceIndentation: All
FixNamespaceComments: false
ReflowComments: false
SortIncludes: Never
SortUsingDeclarations: Never
IncludeBlocks: Preserve
InsertBraces: false
InsertNewlineAtEOF: true
RemoveBracesLLVM: false
RemoveParentheses: Leave
RemoveSemicolon: false
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 1
EmptyLineBeforeAccessModifier: Leave
EmptyLineAfterAccessModifier: Leave
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakStringLiterals: false
LambdaBodyIndentation: OuterScope
Cpp11BracedListStyle: false
SpaceBeforeCpp11BracedList: false
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: true
SpacesBeforeTrailingComments: 1
SpacesInLineCommentPrefix:
  Minimum: 1
  Maximum: -1
LineEnding: LF
