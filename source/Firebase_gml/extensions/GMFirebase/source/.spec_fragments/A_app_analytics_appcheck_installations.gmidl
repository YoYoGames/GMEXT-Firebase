// ============================================================
// App core
// ============================================================

[global, bind = typed_gml]
function firebase_app_initialize(): real;

[global, bind = typed_gml]
function firebase_app_is_initialized(): real;

[global, bind = typed_gml]
function firebase_app_get_name(): string;

// ============================================================
// Utility
// ============================================================

[global, bind = typed_gml]
function firebase_last_error_code(): real;

[global, bind = typed_gml]
function firebase_last_error_message(): string;

// ============================================================
// Analytics
// ============================================================

[global, bind = typed_gml]
function firebase_analytics_initialize(): real;

[global, bind = typed_gml]
function firebase_analytics_terminate(): unit;

[global, bind = typed_gml]
function firebase_analytics_set_analytics_collection_enabled(
	enabled: real
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_consent(
	ad_storage: real,
	analytics_storage: real,
	ad_user_data: real,
	ad_personalization: real
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_event(
	name: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_event_string(
	name: string,
	parameter_name: string,
	parameter_value: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_event_number(
	name: string,
	parameter_name: string,
	parameter_value: real
): unit;

// params: array of {name: string, value: <real|string|bool|array|struct>}.
[global, bind = typed_gml]
function firebase_analytics_log_event_params(
	name: string,
	params: gmval
): unit;

// params: array of {name: string, value: <real|string|bool|array|struct>}.
[global, bind = typed_gml]
function firebase_analytics_set_default_event_parameters(
	params: gmval
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_apple_transaction(
	transaction_id: string,
	[type_hint=`func?`] callback: gmval
): real;

[global, bind = typed_gml]
function firebase_analytics_set_user_property(
	name: string,
	value: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_user_id(
	user_id: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_session_timeout_duration(
	milliseconds: real
): unit;

[global, bind = typed_gml]
function firebase_analytics_reset_analytics_data(): unit;

// callback(error_code: real, error_message: string, instance_id: string)
[global, bind = typed_gml]
function firebase_analytics_get_analytics_instance_id(
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, session_id: real)
[global, bind = typed_gml]
function firebase_analytics_get_session_id(
	[type_hint=`func?`] callback: gmval
): real;

// Desktop-only diagnostics; no-op on iOS/Android (see firebase/analytics.h).
[global, bind = typed_gml]
function firebase_analytics_notify_app_lifecycle_termination(): unit;

[global, bind = typed_gml]
function firebase_analytics_is_desktop_initialized(): real;

[global, bind = typed_gml]
function firebase_analytics_set_desktop_debug_mode(
	enabled: real
): unit;

// callback(log_level: real, message: string). Windows Desktop only.
[global, bind = typed_gml]
function firebase_analytics_set_log_callback(
	[type_hint=`func?`] callback: gmval
): unit;

// iOS/tvOS only; no-op elsewhere.
[global, bind = typed_gml]
function firebase_analytics_initiate_on_device_conversion_measurement_email(
	email_address: string
): unit;

// iOS only; no-op elsewhere.
[global, bind = typed_gml]
function firebase_analytics_initiate_on_device_conversion_measurement_phone(
	phone_number: string
): unit;

// ============================================================
// App Check
// ============================================================

[global, bind = typed_gml]
enum FirebaseAppCheckProvider
{
	Debug = 0,
	DeviceCheck = 1,
	PlayIntegrity = 2,
	AppAttest = 3,
}

// Call before firebase_app_initialize() - some platforms only honor the
// provider factory if it is set before the underlying firebase::App exists.
[global, bind = typed_gml]
function firebase_app_check_set_provider_factory(
	provider: real
): unit;

[global, bind = typed_gml]
function firebase_app_check_debug_provider_set_debug_token(
	token: string
): unit;

[global, bind = typed_gml]
function firebase_app_check_set_token_auto_refresh_enabled(
	enabled: real
): unit;

// callback(error_code: real, error_message: string, token: {token: string, expire_time_millis: real})
[global, bind = typed_gml]
function firebase_app_check_get_token(
	force_refresh: real,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, token: {token: string, expire_time_millis: real})
[global, bind = typed_gml]
function firebase_app_check_get_limited_use_token(
	[type_hint=`func?`] callback: gmval
): real;

// callback(token: {token: string, expire_time_millis: real}), fired on every
// token change. Returns a listener ref for firebase_app_check_remove_listener.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_app_check_add_listener(
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml]
function firebase_app_check_remove_listener(
	[type_hint=`uint64`] listener_ref: gmval
): real;

// ============================================================
// Installations
// ============================================================

// callback(error_code: real, error_message: string, id: string)
[global, bind = typed_gml]
function firebase_installations_get_id(
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, token: string)
[global, bind = typed_gml]
function firebase_installations_get_token(
	force_refresh: real,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_installations_delete(
	[type_hint=`func?`] callback: gmval
): real;
