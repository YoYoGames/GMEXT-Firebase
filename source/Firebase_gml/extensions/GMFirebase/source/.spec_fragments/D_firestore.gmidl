// DocumentSnapshot
// ============================================================

[global, bind = typed_gml]
function firestore_document_snapshot_exists(
	[type_hint=`uint64`] ref: gmval
): bool;

[global, bind = typed_gml]
function firestore_document_snapshot_id(
	[type_hint=`uint64`] ref: gmval
