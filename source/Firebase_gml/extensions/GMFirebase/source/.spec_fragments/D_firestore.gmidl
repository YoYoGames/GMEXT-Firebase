// ============================================================
// Firestore - enums
// ============================================================

[global, bind = typed_gml]
enum FirestoreError
{
	Ok = 0,
	Cancelled = 1,
	Unknown = 2,
	InvalidArgument = 3,
	DeadlineExceeded = 4,
	NotFound = 5,
	AlreadyExists = 6,
	PermissionDenied = 7,
	ResourceExhausted = 8,
	FailedPrecondition = 9,
	Aborted = 10,
	OutOfRange = 11,
	Unimplemented = 12,
	Internal = 13,
	Unavailable = 14,
	DataLoss = 15,
	Unauthenticated = 16,
}

[global, bind = typed_gml]
enum FirestoreSource
{
	Default = 0,
	Cache = 1,
	Server = 2,
}

[global, bind = typed_gml]
enum FirestoreDirection
{
	Ascending = 0,
	Descending = 1,
}

[global, bind = typed_gml]
enum FirestoreServerTimestampBehavior
{
	None = 0,
	Estimate = 1,
	Previous = 2,
}

[global, bind = typed_gml]
enum FirestoreDocumentChangeType
{
	Added = 0,
	Modified = 1,
	Removed = 2,
}

// ============================================================
// Firestore - instance / settings / lifecycle
// ============================================================

// Attaches to the shared firebase::App from firebase_app_initialize() and
// the "(default)" database. Returns a ref for every other firestore_*()
// function below.
[global, bind = typed_gml, type_hint=`uint64`]
function firestore_get_instance(): gmval;

// Same as firestore_get_instance() but for a named (multi-database) Firestore
// database instead of "(default)".
[global, bind = typed_gml, type_hint=`uint64`]
function firestore_get_instance_for_database(
	database_name: string
): gmval;

[global, bind = typed_gml]
function firestore_settings_get_host(
	[type_hint=`uint64`] instance_ref: gmval
): string;

[global, bind = typed_gml]
function firestore_settings_set_host(
	[type_hint=`uint64`] instance_ref: gmval,
	host: string
): unit;

[global, bind = typed_gml]
function firestore_settings_get_ssl_enabled(
	[type_hint=`uint64`] instance_ref: gmval
): bool;

[global, bind = typed_gml]
function firestore_settings_set_ssl_enabled(
	[type_hint=`uint64`] instance_ref: gmval,
	enabled: bool
): unit;

[global, bind = typed_gml]
function firestore_settings_get_persistence_enabled(
	[type_hint=`uint64`] instance_ref: gmval
): bool;

[global, bind = typed_gml]
function firestore_settings_set_persistence_enabled(
	[type_hint=`uint64`] instance_ref: gmval,
	enabled: bool
): unit;

[global, bind = typed_gml]
function firestore_settings_get_cache_size_bytes(
	[type_hint=`uint64`] instance_ref: gmval
): real;

[global, bind = typed_gml]
function firestore_settings_set_cache_size_bytes(
	[type_hint=`uint64`] instance_ref: gmval,
	bytes: real
): unit;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_collection(
	[type_hint=`uint64`] instance_ref: gmval,
	path: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_document(
	[type_hint=`uint64`] instance_ref: gmval,
	path: string
): gmval;

// Query across every collection with this id, at any depth under the
// database root (Firestore::CollectionGroup). Returned ref is a plain query
// ref - use the firestore_query_*() functions on it, same as any other query.
[global, bind = typed_gml, type_hint=`uint64`]
function firestore_collection_group(
	[type_hint=`uint64`] instance_ref: gmval,
	collection_id: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_batch(
	[type_hint=`uint64`] instance_ref: gmval
): gmval;

// level: a firebase::LogLevel ordinal (kLogLevelVerbose=0 .. kLogLevelAssert=6).
[global, bind = typed_gml]
function firestore_set_log_level(
	level: real
): unit;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_enable_network(
	[type_hint=`uint64`] instance_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_disable_network(
	[type_hint=`uint64`] instance_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string). instance_ref (and every
// ref derived from it) must not be used again once this completes.
[global, bind = typed_gml]
function firestore_terminate(
	[type_hint=`uint64`] instance_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_clear_persistence(
	[type_hint=`uint64`] instance_ref: gmval,
	[type_hint=`func?`] callback: gmval
