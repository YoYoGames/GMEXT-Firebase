[global, bind = typed_gml]
function firestore_document_ref_get(
	[type_hint=`uint64`] ref: gmval,
	source: real,
	[type_hint=`func?`] callback: gmval
): real;

// data: struct of field name -> value. Overwrites the whole document (or
// creates it if missing).
// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_document_ref_set(
	[type_hint=`uint64`] ref: gmval,
	data: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// Same as firestore_document_ref_set(), but merges into any existing document
// instead of overwriting it (SetOptions::Merge()).
// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_document_ref_set_merge(
	[type_hint=`uint64`] ref: gmval,
	data: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// Same as firestore_document_ref_set_merge(), but only merges the listed
// dotted field paths (SetOptions::MergeFields()). fields: array of string.
// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_document_ref_set_merge_fields(
	[type_hint=`uint64`] ref: gmval,
	data: gmval,
	fields: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// data: struct of field name -> value. Fails if the document does not exist.
// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_document_ref_update(
	[type_hint=`uint64`] ref: gmval,
	data: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_document_ref_delete(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// Fires once immediately with the current cached/server value, then again on
// every subsequent change, until firestore_listener_registration_remove() is
// called with the returned ref. A callback is required.
// callback(error_code: real, error_message: string, snapshot_ref: uint64)
[global, bind = typed_gml, type_hint=`uint64`]
function firestore_document_ref_add_snapshot_listener(
	[type_hint=`uint64`] ref: gmval,
	include_metadata_changes: bool,
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml]
function firestore_document_ref_is_valid(
	[type_hint=`uint64`] ref: gmval
): bool;

[global, bind = typed_gml]
function firestore_document_ref_release(
	[type_hint=`uint64`] ref: gmval
): unit;

// ============================================================
// Query
// ============================================================
// Every function below also accepts a CollectionReference ref in place of a
// Query ref (CollectionReference publicly inherits from Query in the SDK),
// so e.g. firestore_query_where_equal_to(firestore_collection(...), ...)
// is valid and returns a new, independent Query ref reflecting the added
// clause - none of these mutate the ref passed in.

