// ============================================================
// FieldValue - sentinels + explicit-typed value constructors
// ============================================================
// Every function below mints a ref that is only meaningful fed back into a
// data struct passed to *_set()/_set_merge()/_set_merge_fields()/_update()/
// _add() (or, for firestore_field_value_reference(), also directly wherever
// a value is expected, e.g. firestore_query_where_equal_to()). GML has no
// int64 or a way to tag a raw real as "this must be a Firestore Timestamp/
// GeoPoint/Reference/Blob/int64" - these constructors are how script code
// opts into that exact typing; a plain real/string/bool/array/struct in a
// data map is otherwise stored as double/string/bool/array/map respectively.

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_delete(): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_server_timestamp(): gmval;

// values: array of value. Adds elements not already present in the stored
// array; a no-op on any element that already exists there.
[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_array_union(
	values: gmval
): gmval;

// values: array of value. Removes all matching elements from the stored array.
[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_array_remove(
	values: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_increment_integer(
	value: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_increment_double(
	value: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_integer(
	value: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_double(
	value: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_timestamp(
	seconds: real,
	nanoseconds: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_geo_point(
	latitude: real,
	longitude: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_reference(
	[type_hint=`uint64`] document_ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_blob(
	data: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firestore_field_value_null(): gmval;

[global, bind = typed_gml]
function firestore_field_value_release(
	[type_hint=`uint64`] ref: gmval
): unit;

