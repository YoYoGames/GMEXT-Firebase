[global, bind = typed_gml]
function firestore_write_batch_set(
	[type_hint=`uint64`] batch_ref: gmval,
	[type_hint=`uint64`] document_ref: gmval,
	data: gmval
): real;

[global, bind = typed_gml]
function firestore_write_batch_set_merge(
	[type_hint=`uint64`] batch_ref: gmval,
	[type_hint=`uint64`] document_ref: gmval,
	data: gmval
): real;

// fields: array of string.
[global, bind = typed_gml]
function firestore_write_batch_set_merge_fields(
	[type_hint=`uint64`] batch_ref: gmval,
	[type_hint=`uint64`] document_ref: gmval,
	data: gmval,
	fields: gmval
): real;

[global, bind = typed_gml]
function firestore_write_batch_update(
	[type_hint=`uint64`] batch_ref: gmval,
	[type_hint=`uint64`] document_ref: gmval,
	data: gmval
): real;

[global, bind = typed_gml]
function firestore_write_batch_delete(
	[type_hint=`uint64`] batch_ref: gmval,
	[type_hint=`uint64`] document_ref: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firestore_write_batch_commit(
	[type_hint=`uint64`] batch_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

[global, bind = typed_gml]
function firestore_write_batch_release(
	[type_hint=`uint64`] batch_ref: gmval
