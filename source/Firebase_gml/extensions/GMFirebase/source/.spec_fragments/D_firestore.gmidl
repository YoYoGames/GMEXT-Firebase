function firestore_document_snapshot_metadata_is_from_cache(
	[type_hint=`uint64`] ref: gmval
): bool;

// server_timestamp_behavior: a FirestoreServerTimestampBehavior value.
// Returns { exists: bool, value: <field value, or undefined if not exists> }.
// A composite value kind with no single GML primitive is encoded as a small
// tagged struct: { type: "timestamp", seconds: real, nanoseconds: real } or
// { type: "geopoint", latitude: real, longitude: real }; a document reference
// field is encoded as a plain uint64 DocumentReference ref (a real number),
// the same as every other reference-typed handle in this extension; nested
// arrays/maps recurse using the same rules.
[global, bind = typed_gml]
function firestore_document_snapshot_get(
	[type_hint=`uint64`] ref: gmval,
	field: string,
	server_timestamp_behavior: real
): gmval;

// server_timestamp_behavior: a FirestoreServerTimestampBehavior value.
// Returns the document's full field map as a struct, field name -> value,
// using the same value encoding as firestore_document_snapshot_get().
[global, bind = typed_gml]
function firestore_document_snapshot_get_data(
	[type_hint=`uint64`] ref: gmval,
	server_timestamp_behavior: real
): gmval;

[global, bind = typed_gml]
function firestore_document_snapshot_release(
	[type_hint=`uint64`] ref: gmval
): unit;

