// ============================================================
// Cloud Messaging
// ============================================================
//
// Messaging exposes no per-instance handle - every function below is
// global. messaging_poll_message()/messaging_poll_token() drain the SDK's
// own PollableListener buffer and should be called once per step from
// GML's event loop; the per-field getters below read back whatever the
// most recent successful poll populated.

[global, bind = typed_gml]
function messaging_initialize(): real;

[global, bind = typed_gml]
function messaging_terminate(): unit;

[global, bind = typed_gml]
function messaging_set_token_registration_on_init_enabled(
	enabled: real
