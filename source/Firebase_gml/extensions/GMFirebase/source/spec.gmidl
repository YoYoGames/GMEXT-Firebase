// Consolidates firebase_firestore_document_snapshot_exists/id/
// metadata_has_pending_writes/metadata_is_from_cache into a single call. It
// carries no handle: firebase_firestore_document_snapshot_reference()
// registers the document's reference as a handle the caller owns. undefined
// when `ref` is not a registered DocumentSnapshot (InvalidHandle in the last
// error).
[global, bind = typed_gml, type_hint=`FirestoreDocumentSnapshotInfo?`]
function firebase_firestore_document_snapshot_get_info(
	[type_hint=`uint64`] ref: gmval
