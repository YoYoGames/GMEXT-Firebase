// ============================================================
// User Messaging Platform (UMP) - consent
// ============================================================

[global, bind = typed_gml]
enum FirebaseUmpConsentStatus
{
	Unknown = 0,
	Required = 1,
	NotRequired = 2,
	Obtained = 3,
}

[global, bind = typed_gml]
enum FirebaseUmpConsentFormStatus
{
	Unknown = 0,
	Unavailable = 1,
	Available = 2,
}

[global, bind = typed_gml]
enum FirebaseUmpPrivacyOptionsRequirementStatus
{
	Unknown = 0,
	NotRequired = 1,
	Required = 2,
}

[global, bind = typed_gml]
enum FirebaseUmpConsentDebugGeography
{
	Disabled = 0,
	EEA = 1,
	NonEEA = 2,
}

// Nullable: fails (returns no value) if there is no firebase::App yet, or
// if ConsentInfo::GetInstance() itself fails to initialize.
[global, bind = typed_gml, type_hint=`uint64?`]
function firebase_ump_get_instance(): gmval;

[global, bind = typed_gml]
function firebase_ump_get_consent_status(
	[type_hint=`uint64`] consent_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_ump_get_consent_form_status(
	[type_hint=`uint64`] consent_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_ump_get_privacy_options_requirement_status(
	[type_hint=`uint64`] consent_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_ump_can_request_ads(
	[type_hint=`uint64`] consent_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_ump_reset(
	[type_hint=`uint64`] consent_ref: gmval
): unit;

// debug_device_ids: a GML array of strings (may be `undefined` - treated as
// empty). callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_ump_request_consent_info_update(
