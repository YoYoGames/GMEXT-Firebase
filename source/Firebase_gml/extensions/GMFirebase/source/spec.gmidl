// ============================================================
// Firestore - enums
// ============================================================

[global, bind = typed_gml]
enum FirestoreError
{
	Ok = 0,
	Cancelled = 1,
	Unknown = 2,
	InvalidArgument = 3,
	DeadlineExceeded = 4,
	NotFound = 5,
	AlreadyExists = 6,
	PermissionDenied = 7,
	ResourceExhausted = 8,
	FailedPrecondition = 9,
	Aborted = 10,
	OutOfRange = 11,
	Unimplemented = 12,
	Internal = 13,
	Unavailable = 14,
	DataLoss = 15,
	Unauthenticated = 16,
}

[global, bind = typed_gml]
enum FirestoreSource
{
	Default = 0,
	Cache = 1,
	Server = 2,
}

[global, bind = typed_gml]
enum FirestoreDirection
{
	Ascending = 0,
	Descending = 1,
}

[global, bind = typed_gml]
enum FirestoreServerTimestampBehavior
{
	None = 0,
	Estimate = 1,
	Previous = 2,
}

[global, bind = typed_gml]
enum FirestoreDocumentChangeType
{
	Added = 0,
	Modified = 1,
	Removed = 2,
}

// ============================================================
// Firestore - instance / settings / lifecycle
// ============================================================

// Attaches to the shared firebase::App from firebase_app_initialize() and
