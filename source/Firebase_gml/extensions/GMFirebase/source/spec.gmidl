[gml_api]
module GMFirebase;

// ============================================================
// Public ABI / allocation policy
// ============================================================
// Native-backed Firebase identity objects are represented as packed handles:
// [extension id | Firebase-local type | 32-bit registry id]. The payload is
// always a registry id - never a native pointer. Normal identity handles use
// typed uint64 on the GML API. Firestore helper handles that are intentionally
// embedded inside dynamic gmval structs/arrays (FieldValue/FieldPath/Filter)
// are surfaced as exact GML reals instead; the packed layout uses only 50 bits,
// so this loses no precision and avoids requiring caller-side real() casts.
//
// GameMaker classes below are reserved for explicit value materialization
// (for example *_get_info()), configuration, or result data that GML actually
// needs to inspect. Hot-path listeners return handles and primitive callback
// values; callers opt into struct/array allocation only when they request it.

// ============================================================
// App core
// ============================================================

[global, bind = typed_gml]
function firebase_app_initialize(): bool;

[global, bind = typed_gml]
function firebase_app_is_initialized(): bool;

[global, bind = typed_gml]
function firebase_app_get_name(): string;

// ============================================================
// Utility
// ============================================================

// What every asynchronous call returns. Ok means the call reached the SDK and
// the callback will fire exactly once with the SDK's own result; any other
// value means the call failed before the SDK was involved and the callback
// will not fire at all. Kept in their own negative band so they can never be
// mistaken for a product's error enum (the SDK's are all zero or positive
// except the two Unimplemented values, which are -1).
[global, bind = typed_gml]
enum FirebaseError
{
	Ok = 0,
	InvalidHandle = -1000,
	NotInitialized = -1001,
	InvalidArgument = -1002,
	Unsupported = -1003,
}

// The error of the last call that failed before reaching the SDK - an invalid
// handle, an uninitialized module, a rejected argument. Set on the calling
// thread, read after a synchronous return. An SDK result is only ever
// delivered to that call's callback and never lands here.
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_last_error_code(): gmval;

[global, bind = typed_gml]
function firebase_last_error_message(): string;

// ============================================================
// Analytics
// ============================================================

[global, bind = typed_gml]
function firebase_analytics_initialize(): bool;

[global, bind = typed_gml]
function firebase_analytics_terminate(): unit;

[global, bind = typed_gml]
function firebase_analytics_set_analytics_collection_enabled(
	enabled: bool
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_consent(
	ad_storage: bool,
	analytics_storage: bool,
	ad_user_data: bool,
	ad_personalization: bool
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_event(
	name: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_event_string(
	name: string,
	parameter_name: string,
	parameter_value: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_log_event_number(
	name: string,
	parameter_name: string,
	parameter_value: real
): unit;

// One firebase::analytics::Parameter. value is any GML value the Variant
// converter accepts (real, string, bool, array, struct, undefined for null).
[global]
class `[[FirebaseAnalyticsParameter]]` prototype Object
{
	[field] property name: string { get; set; }
	[field] property value: gmval { get; set; }
}

[global, bind = typed_gml]
function firebase_analytics_log_event_params(
	name: string,
	[type_hint=`FirebaseAnalyticsParameter[]`] params: gmval
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_default_event_parameters(
	[type_hint=`FirebaseAnalyticsParameter[]`] params: gmval
): unit;

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_analytics_log_apple_transaction(
	transaction_id: string,
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml]
function firebase_analytics_set_user_property(
	name: string,
	value: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_user_id(
	user_id: string
): unit;

[global, bind = typed_gml]
function firebase_analytics_set_session_timeout_duration(
	milliseconds: real
): unit;

[global, bind = typed_gml]
function firebase_analytics_reset_analytics_data(): unit;

// callback(error_code: real, error_message: string, instance_id: string)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_analytics_get_analytics_instance_id(
	[type_hint=`func?`] callback: gmval
): gmval;

// callback(error_code: real, error_message: string, session_id: real)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_analytics_get_session_id(
	[type_hint=`func?`] callback: gmval
): gmval;

// Desktop-only diagnostics; no-op on iOS/Android (see firebase/analytics.h).
[global, bind = typed_gml]
function firebase_analytics_notify_app_lifecycle_termination(): unit;

[global, bind = typed_gml]
function firebase_analytics_is_desktop_initialized(): bool;

[global, bind = typed_gml]
function firebase_analytics_set_desktop_debug_mode(
	enabled: bool
): unit;

// callback(log_level: real, message: string). Windows Desktop only.
[global, bind = typed_gml]
function firebase_analytics_set_log_callback(
	[type_hint=`func?`] callback: gmval
): unit;

// iOS/tvOS only; no-op elsewhere.
[global, bind = typed_gml]
function firebase_analytics_initiate_on_device_conversion_measurement_email(
	email_address: string
): unit;

// iOS only; no-op elsewhere.
[global, bind = typed_gml]
function firebase_analytics_initiate_on_device_conversion_measurement_phone(
	phone_number: string
): unit;

// ============================================================
// App Check
// ============================================================

// Mirrors firebase::app_check::AppCheckError (firebase/app_check.h) - the
// error_code every App Check token callback receives. Android reports every
// failure as Unknown; iOS and desktop map the platform's own codes.
[global, bind = typed_gml]
enum FirebaseAppCheckError
{
	None = 0,
	ServerUnreachable = 1,
	InvalidConfiguration = 2,
	SystemKeychain = 3,
	UnsupportedProvider = 4,
	Unknown = 5,
}

[global, bind = typed_gml]
enum FirebaseAppCheckProvider
{
	Debug = 0,
	DeviceCheck = 1,
	PlayIntegrity = 2,
	AppAttest = 3,
}

// firebase::app_check::AppCheckToken.
[global]
class `[[FirebaseAppCheckToken]]` prototype Object
{
	[field] property token: string { get; set; }
	[field, type_hint=`real`] property expire_time_millis: gmval { get; set; }
}

// Call before firebase_app_initialize() - some platforms only honor the
// provider factory if it is set before the underlying firebase::App exists.
[global, bind = typed_gml]
function firebase_app_check_set_provider_factory(
	[type_hint=`FirebaseAppCheckProvider`] provider: gmval
): unit;

[global, bind = typed_gml]
function firebase_app_check_debug_provider_set_debug_token(
	token: string
): unit;

[global, bind = typed_gml]
function firebase_app_check_set_token_auto_refresh_enabled(
	enabled: bool
): unit;

// callback(error_code: FirebaseAppCheckError, error_message: string, token: FirebaseAppCheckToken)
// - token is undefined when error_code is not 0.
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_app_check_get_token(
	force_refresh: bool,
	[type_hint=`func?`] callback: gmval
): gmval;

// callback(error_code: FirebaseAppCheckError, error_message: string, token: FirebaseAppCheckToken)
// - token is undefined when error_code is not 0.
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_app_check_get_limited_use_token(
	[type_hint=`func?`] callback: gmval
): gmval;

// callback(token: FirebaseAppCheckToken), fired on every
// token change. Returns a listener ref for firebase_app_check_remove_listener.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_app_check_add_listener(
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml]
function firebase_app_check_remove_listener(
	[type_hint=`uint64`] listener_ref: gmval
): bool;

// ============================================================
// Installations
// ============================================================

// callback(error_code: real, error_message: string, id: string)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_installations_get_id(
	[type_hint=`func?`] callback: gmval
): gmval;

// callback(error_code: real, error_message: string, token: string)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_installations_get_token(
	force_refresh: bool,
	[type_hint=`func?`] callback: gmval
): gmval;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_installations_delete(
	[type_hint=`func?`] callback: gmval
): gmval;

// ============================================================
// Auth - error codes
// ============================================================
// Mirrors firebase::auth::AuthError (firebase/auth/types.h) exactly, value for
// value, so C++ can hand these codes across the wire as plain numbers with no
// translation step and GML code can still compare against named constants.
// The tail of the real SDK enum (kAuthErrorInvalidEventHandler and onward) is
// gated behind #ifdef INTERNAL_EXPERIMENTAL in the SDK header, which is not
// defined in a normal SDK consumption build, so those members do not exist in
// the ABI we link against and are intentionally omitted here too.
[global, bind = typed_gml]
enum FirebaseAuthError
{
	None = 0,
	Unimplemented = -1,
	Failure = 1,
	InvalidCustomToken = 2,
	CustomTokenMismatch = 3,
	InvalidCredential = 4,
	UserDisabled = 5,
	AccountExistsWithDifferentCredentials = 6,
	OperationNotAllowed = 7,
	EmailAlreadyInUse = 8,
	RequiresRecentLogin = 9,
	CredentialAlreadyInUse = 10,
	InvalidEmail = 11,
	WrongPassword = 12,
	TooManyRequests = 13,
	UserNotFound = 14,
	ProviderAlreadyLinked = 15,
	NoSuchProvider = 16,
	InvalidUserToken = 17,
	UserTokenExpired = 18,
	NetworkRequestFailed = 19,
	InvalidApiKey = 20,
	AppNotAuthorized = 21,
	UserMismatch = 22,
	WeakPassword = 23,
	NoSignedInUser = 24,
	ApiNotAvailable = 25,
	ExpiredActionCode = 26,
	InvalidActionCode = 27,
	InvalidMessagePayload = 28,
	InvalidPhoneNumber = 29,
	MissingPhoneNumber = 30,
	InvalidRecipientEmail = 31,
	InvalidSender = 32,
	InvalidVerificationCode = 33,
	InvalidVerificationId = 34,
	MissingVerificationCode = 35,
	MissingVerificationId = 36,
	MissingEmail = 37,
	MissingPassword = 38,
	QuotaExceeded = 39,
	RetryPhoneAuth = 40,
	SessionExpired = 41,
	AppNotVerified = 42,
	AppVerificationFailed = 43,
	CaptchaCheckFailed = 44,
	InvalidAppCredential = 45,
	MissingAppCredential = 46,
	InvalidClientId = 47,
	InvalidContinueUri = 48,
	MissingContinueUri = 49,
	KeychainError = 50,
	MissingAppToken = 51,
	MissingIosBundleId = 52,
	NotificationNotForwarded = 53,
	UnauthorizedDomain = 54,
	WebContextAlreadyPresented = 55,
	WebContextCancelled = 56,
	DynamicLinkNotActivated = 57,
	Cancelled = 58,
	InvalidProviderId = 59,
	WebInternalError = 60,
	WebStorateUnsupported = 61,
	TenantIdMismatch = 62,
	UnsupportedTenantOperation = 63,
	InvalidLinkDomain = 64,
	RejectedCredential = 65,
	PhoneNumberNotFound = 66,
	InvalidTenantId = 67,
	MissingClientIdentifier = 68,
	MissingMultiFactorSession = 69,
	MissingMultiFactorInfo = 70,
	InvalidMultiFactorSession = 71,
	MultiFactorInfoNotFound = 72,
	AdminRestrictedOperation = 73,
	UnverifiedEmail = 74,
	SecondFactorAlreadyEnrolled = 75,
	MaximumSecondFactorCountExceeded = 76,
	UnsupportedFirstFactor = 77,
	EmailChangeNeedsVerification = 78,
	// The eight below are INTERNAL_EXPERIMENTAL in the public auth/types.h,
	// but the prebuilt SDK's Android and iOS error tables emit them at these
	// ordinals - UserCancelled is a dismissed federated sign-in.
	InvalidEventHandler = 79,
	FederatedProviderAreadyInUse = 80,
	InvalidAuthenticatedUserData = 81,
	FederatedSignInUserInteractionFailure = 82,
	MissingOrInvalidNonce = 83,
	UserCancelled = 84,
	UnsupportedPassthroughOperation = 85,
	TokenRefreshUnavailable = 86,
}

// ============================================================
// Auth core
// ============================================================

// Lazily creates/fetches the singleton firebase::auth::Auth for the shared
// firebase::App (see firebase_app_initialize()). Returns false and sets
// firebase_last_error_code()/message() on failure - most commonly because
// firebase_app_initialize() has not been called yet.
[global, bind = typed_gml]
function firebase_auth_get_auth(): bool;

[global, bind = typed_gml]
function firebase_auth_language_code(): string;

[global, bind = typed_gml]
function firebase_auth_set_language_code(
	language_code: string
): unit;

[global, bind = typed_gml]
function firebase_auth_use_app_language(): unit;

[global, bind = typed_gml]
function firebase_auth_use_emulator(
	host: string,
	port: real
): unit;

// Ref to the currently signed-in user, or `undefined` if nobody is signed in.
// A user ref is a live view of this Auth instance's current user, not a
// snapshot: it reports whoever is signed in now, firebase_auth_user_is_valid()
// is false while nobody is, and the same ref comes back on every call and
// from every sign-in result and listener event.
[global, bind = typed_gml, type_hint=`uint64?`]
function firebase_auth_current_user(): gmval;

[global, bind = typed_gml]
function firebase_auth_sign_out(): unit;

// callback(error_code: real, error_message: string, providers: string[])
// - providers is empty when error_code is not 0.
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_fetch_providers_for_email(
	email: string,
	[type_hint=`func?`] callback: gmval
): gmval;

// ============================================================
// Sign-in / sign-up
// ============================================================
// Every function below follows the same callback shape:
//   callback(error_code: real, error_message: string, user: uint64 or undefined)
// `user` is a GM_FB_TYPE_AUTH_USER ref (see firebase_auth_user_* below);
// release it with firebase_auth_user_release() once done with it.

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_sign_in_with_custom_token(
	custom_token: string,
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_sign_in_with_credential(
	[type_hint=`uint64`] credential_ref: gmval,
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_sign_in_and_retrieve_data_with_credential(
	[type_hint=`uint64`] credential_ref: gmval,
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_sign_in_anonymously(
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_sign_in_with_email_and_password(
	email: string,
	password: string,
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_create_user_with_email_and_password(
	email: string,
	password: string,
	[type_hint=`func?`] callback: gmval
): gmval;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_send_password_reset_email(
	email: string,
	[type_hint=`func?`] callback: gmval
): gmval;

// ============================================================
// AuthStateListener / IdTokenListener
// ============================================================
// callback(user: uint64 or undefined), fired every time the signed-in user
// changes (sign-in, sign-out, or - for the id-token variant - token refresh).
// Returns a listener ref for the matching remove function below.

[global, bind = typed_gml, type_hint=`uint64?`]
function firebase_auth_add_state_listener(
	callback: func
): gmval;

[global, bind = typed_gml]
function firebase_auth_remove_state_listener(
	[type_hint=`uint64`] listener_ref: gmval
): unit;

[global, bind = typed_gml, type_hint=`uint64?`]
function firebase_auth_add_id_token_listener(
	callback: func
): gmval;

[global, bind = typed_gml]
function firebase_auth_remove_id_token_listener(
	[type_hint=`uint64`] listener_ref: gmval
): unit;

// ============================================================
// Credential
// ============================================================
// firebase::auth::Credential is an opaque, provider-agnostic value handed to
// sign-in/link/reauthenticate calls above and to firebase_auth_user_link_with_
// credential/reauthenticate below. Every *_get_credential() factory below
// mints one of these refs.

[global, bind = typed_gml]
function firebase_auth_credential_provider(
	[type_hint=`uint64`] credential_ref: gmval
): string;

[global, bind = typed_gml]
function firebase_auth_credential_is_valid(
	[type_hint=`uint64`] credential_ref: gmval
): bool;

[global, bind = typed_gml]
function firebase_auth_credential_release(
	[type_hint=`uint64`] credential_ref: gmval
): unit;

// ============================================================
// Identity provider factories
// ============================================================
// Every one of these is a synchronous, local-only value construction (no
// network round-trip) that mints a GM_FB_TYPE_AUTH_CREDENTIAL ref, except
// firebase_auth_game_center_auth_provider_get_credential(), which talks to the
// local GameCenter session and is genuinely async.

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_email_auth_provider_get_credential(
	email: string,
	password: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_facebook_auth_provider_get_credential(
	access_token: string
): gmval;

// callback(error_code: real, error_message: string, credential: uint64 or undefined)
[global, bind = typed_gml, type_hint=`FirebaseError`]
function firebase_auth_game_center_auth_provider_get_credential(
	[type_hint=`func?`] callback: gmval
): gmval;

[global, bind = typed_gml]
function firebase_auth_game_center_auth_provider_is_player_authenticated(): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_github_auth_provider_get_credential(
	token: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_google_auth_provider_get_credential(
	id_token: string,
	access_token: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_oauth_provider_get_credential(
	provider_id: string,
	id_token: string,
	access_token: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_oauth_provider_get_credential_with_nonce(
	provider_id: string,
	id_token: string,
	raw_nonce: string,
	access_token: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_play_games_auth_provider_get_credential(
	server_auth_code: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_twitter_auth_provider_get_credential(
	token: string,
	secret: string
): gmval;

// ============================================================
// Phone Auth
// ============================================================
// Starts verification and returns a listener handle. Pass 0 for
// force_resending_token on a new verification. The SDK uses the Firebase App's
// default Activity/UIView for app-verification UI.
// on_verification_completed(phone_credential: uint64)
// on_verification_failed(error_code: real, error_message: string)
// on_code_sent(verification_id: string, force_resending_token: uint64)
// on_timeout(verification_id: string)
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_phone_verify_phone_number(
	phone_number: string,
	timeout_ms: real,
	[type_hint=`uint64`] force_resending_token: gmval,
	[type_hint=`func?`] on_verification_completed: gmval,
	[type_hint=`func?`] on_verification_failed: gmval,
	[type_hint=`func?`] on_code_sent: gmval,
	[type_hint=`func?`] on_timeout: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_auth_phone_get_credential(
	verification_id: string,
	verification_code: string
): gmval;

[global, bind = typed_gml]
function firebase_auth_phone_credential_sms_code(
	[type_hint=`uint64`] credential: gmval
): string;

[global, bind = typed_gml]
function firebase_auth_phone_resending_token_release(
	[type_hint=`uint64`] token: gmval
): unit;

[global, bind = typed_gml]
function firebase_auth_phone_listener_release(
	[type_hint=`uint64`] listener: gmval
): unit;

// ============================================================
// User
// ============================================================
// firebase::auth::User has no address of its own (Auth::current_user() and
// every sign-in/link/reauthenticate callback above hand it back by value), so
// every GM_FB_TYPE_AUTH_USER ref below is a private heap copy minted on the
// C++ side. Call firebase_auth_user_release() once done with a user ref;
// releasing it never signs the underlying account out.

// Explicit convenience materialization. Sign-in/current-user/listener paths
// still return only the uint64 user handle. Call this when multiple user
// properties are needed together and the one GML struct allocation is useful.
// firebase::auth::UserInfoInterface - one entry of a user's provider data
// (firebase_auth_user_provider_data_at). Distinct from FirebaseAuthUserInfo
// below: a provider entry has none of the User-only fields.
[global]
class `[[FirebaseAuthProviderUserInfo]]` prototype Object
{
	[field] property uid: string { get; set; }
	[field] property email: string { get; set; }
	[field] property display_name: string { get; set; }
	[field] property photo_url: string { get; set; }
	[field] property provider_id: string { get; set; }
	[field] property phone_number: string { get; set; }
}

// firebase::auth::AdditionalUserInfo. profile is the provider's raw profile
// map (dynamic keys), updated_credential is undefined unless the provider
// returned one.
[global]
class `[[FirebaseAuthAdditionalUserInfo]]` prototype Object
{
	[field] property provider_id: string { get; set; }
	[field] property user_name: string { get; set; }
	[field] property profile: gmval { get; set; }
	[field, type_hint=`uint64?`] property updated_credential: gmval { get; set; }
}

// firebase::auth::AuthResult, delivered by every *_result and *_with_provider
// callback. user is the Auth instance's live user view (see
// firebase_auth_current_user), credential is undefined unless the provider
// returned one; both credential handles need firebase_auth_credential_release.
[global]
class `[[FirebaseAuthResult]]` prototype Object
{
	[field, type_hint=`uint64?`] property user: gmval { get; set; }
	[field, type_hint=`uint64?`] property credential: gmval { get; set; }
	[field, type_hint=`FirebaseAuthAdditionalUserInfo`] property additional_user_info: gmval { get; set; }
}

[global]
class `[[FirebaseAuthUserInfo]]` prototype Object
{
	[field] property uid: string { get; set; }
	[field] property email: string { get; set; }
	[field] property display_name: string { get; set; }
	[field] property photo_url: string { get; set; }
	[field] property provider_id: string { get; set; }
	[field] property phone_number: string { get; set; }
	[field] property is_email_verified: bool { get; set; }
	[field] property is_anonymous: bool { get; set; }
	[field] property is_valid: bool { get; set; }
	[field, type_hint=`real`] property creation_timestamp: gmval { get; set; }
	[field, type_hint=`real`] property last_sign_in_timestamp: gmval { get; set; }
}

[global, bind = typed_gml, type_hint=`FirebaseAuthUserInfo?`]
function firebase_auth_user_get_info(
	[type_hint=`uint64`] user: gmval
): gmval;

// No-op kept for API compatibility: a user ref is the Auth instance's shared
// view (see firebase_auth_current_user) and is never freed.
[global, bind = typed_gml]
function firebase_auth_user_release(
