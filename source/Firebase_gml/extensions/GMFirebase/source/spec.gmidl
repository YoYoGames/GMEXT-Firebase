// firebase::firestore::FieldValue::Type. The last six are the sentinel
// types a document never carries but a handle minted by
// firebase_firestore_field_value_delete() and its siblings reports.
[global, bind = typed_gml]
enum FirestoreFieldValueType
{
	Null = 0,
	Boolean = 1,
	Integer = 2,
	Double = 3,
	Timestamp = 4,
	String = 5,
	Blob = 6,
	Reference = 7,
	GeoPoint = 8,
	Array = 9,
	Map = 10,
	Delete = 11,
	ServerTimestamp = 12,
	ArrayUnion = 13,
	ArrayRemove = 14,
	IncrementInteger = 15,
	IncrementDouble = 16,
}

// firebase::Timestamp as read out of a document or a FieldValue handle. To
// write one, use firebase_firestore_field_value_timestamp().
[global]
class `[[FirestoreTimestamp]]` prototype Object
{
	[field, type_hint=`real`] property seconds: gmval { get; set; }
	[field, type_hint=`real`] property nanoseconds: gmval { get; set; }
}

// firebase::firestore::GeoPoint as read out of a document or a FieldValue
// handle. To write one, use firebase_firestore_field_value_geo_point().
[global]
class `[[FirestoreGeoPoint]]` prototype Object
{
	[field, type_hint=`real`] property latitude: gmval { get; set; }
	[field, type_hint=`real`] property longitude: gmval { get; set; }
}

// A blob as read out of a document. No wire kind carries bytes to GML, so
// the read hands back a FieldValue handle plus the byte count and the game
// copies the bytes into a buffer it sized itself with
// firebase_firestore_field_value_blob_copy(field_value, buffer). The handle
// belongs to the snapshot it was read from: releasing the snapshot frees
// it, and firebase_firestore_field_value_release() frees it earlier. To
// write one, use firebase_firestore_field_value_blob() with a buffer.
[global]
class `[[FirestoreBlob]]` prototype Object
{
	[field, type_hint=`uint64`] property field_value: gmval { get; set; }
	[field, type_hint=`real`] property size: gmval { get; set; }
}

// A document reference as read out of a document: the document's path.
// firebase_firestore_document(firestore, path) resolves it to a handle. To
// write one, use firebase_firestore_field_value_reference().
[global]
class `[[FirestoreReference]]` prototype Object
{
	[field] property path: string { get; set; }
}

// firebase::firestore::DocumentChange. document is a newly registered
// DocumentSnapshot ref (release it); old_index/new_index are -1 when the
// SDK reports npos.
[global]
class `[[FirestoreDocumentChange]]` prototype Object
{
	[field, type_hint=`FirestoreDocumentChangeType`] property type: gmval { get; set; }
	[field, type_hint=`uint64`] property document: gmval { get; set; }
	[field, type_hint=`real`] property old_index: gmval { get; set; }
	[field, type_hint=`real`] property new_index: gmval { get; set; }
}

// Result of DocumentSnapshot::Get(): exists distinguishes a missing field
// from a field whose value is Firestore null (value is undefined in both
// cases). See firebase_firestore_document_snapshot_get for the value rules.
[global]
class `[[FirestoreFieldLookup]]` prototype Object
{
	[field] property exists: bool { get; set; }
	[field] property value: gmval { get; set; }
}

// One entry of a MapFieldPathValue update: a FieldPath handle (a real, from
// firebase_firestore_field_path_create) and the value to write.
[global]
class `[[FirestoreFieldPathValue]]` prototype Object
{
	[field] property field_path: real { get; set; }
	[field] property value: gmval { get; set; }
}

// firebase::firestore::LoadBundleTaskProgress.
[global]
class `[[FirestoreLoadBundleTaskProgress]]` prototype Object
{
	[field, type_hint=`real`] property documents_loaded: gmval { get; set; }
	[field, type_hint=`real`] property total_documents: gmval { get; set; }
