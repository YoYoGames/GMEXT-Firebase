// ============================================================
// Cloud Messaging
// ============================================================
//
// Messaging exposes no per-instance handle - every function below is
// global. The SDK delivers through one Listener with a method per event;
// each is a callback here, set with firebase_messaging_set_*_callback()
// before or after firebase_messaging_initialize(). An event delivered while
// its callback is not set is held - messages in order, the latest
// registration and unregistration id - and handed over the moment it is.

// Mirrors firebase::messaging::Error (firebase/messaging.h) - the error_code
// the permission, registration, token and topic callbacks receive on Android
// and iOS. The desktop stub completes every one of them with None.
[global, bind = typed_gml]
enum FirebaseMessagingError
{
	None = 0,
	FailedToRegisterForRemoteNotifications = 1,
	InvalidTopicName = 2,
	NoRegistrationToken = 3,
	Unknown = 4,
}

