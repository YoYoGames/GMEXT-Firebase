// ============================================================
// Realtime Database - enums
// ============================================================

// Mirrors firebase::LogLevel (firebase/log.h). Shared conceptually with
// Analytics' desktop log callback (which surfaces log_level as a plain
// `real`, not this enum, since it predates this declaration) - if another
// module ever needs a typed log level, reuse this one rather than declaring
// a second FirebaseLogLevel.
[global, bind = typed_gml]
enum FirebaseLogLevel
{
	Verbose = 0,
	Debug = 1,
	Info = 2,
	Warning = 3,
	Error = 4,
	Assert = 5,
}

// Mirrors firebase::database::Error (firebase/database/common.h). Every
// Database callback below that reports an error_code returns one of these
// values as a plain `real` (same convention as the rest of this extension -
// there is no single unified Firebase result enum to bind to), this enum
// exists purely so GML code can use named constants instead of magic numbers.
[global, bind = typed_gml]
enum FirebaseDatabaseError
{
	None = 0,
	Disconnected = 1,
	ExpiredToken = 2,
	InvalidToken = 3,
	MaxRetries = 4,
	NetworkError = 5,
	OperationFailed = 6,
	OverriddenBySet = 7,
	PermissionDenied = 8,
	Unavailable = 9,
	UnknownError = 10,
	WriteCanceled = 11,
	InvalidVariantType = 12,
	ConflictingOperationInProgress = 13,
	TransactionAbortedByUser = 14,
}

// ============================================================
// Realtime Database - Database
// ============================================================
// A Database* is SDK-owned and never deleted by this extension (matching
// Database::GetInstance()'s documented lifetime - it lives as long as the
// App), so there is deliberately no firebase_database_release().

// Uses the default App's default-URL database.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_get_instance(): gmval;

