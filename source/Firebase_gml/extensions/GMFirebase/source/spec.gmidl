[global, bind = typed_gml, type_hint=`uint64`]
function firebase_app_get_instance(name: string): gmval;
// firebase::AppOptions. Every field is optional on input - one left undefined
// keeps the SDK default; on output every field is present, empty when unset
// (the SDK does not distinguish). client_id/package_name are SDK-internal in 13.11.
[global]
class `[[FirebaseAppOptions]]` prototype Object
{
	[field, type_hint=`string?`] property app_id: gmval { get; set; }
	[field, type_hint=`string?`] property api_key: gmval { get; set; }
	[field, type_hint=`string?`] property messaging_sender_id: gmval { get; set; }
	[field, type_hint=`string?`] property database_url: gmval { get; set; }
	[field, type_hint=`string?`] property ga_tracking_id: gmval { get; set; }
	[field, type_hint=`string?`] property storage_bucket: gmval { get; set; }
	[field, type_hint=`string?`] property project_id: gmval { get; set; }
}

