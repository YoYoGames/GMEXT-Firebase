{
  "$schema": "./extgen.schema.json",
  "input": "spec.gmidl",
  "root": "./",
  "gamemaker": {
    "runtime": {
      "outputFile": "../../../scripts/ExtensionCore_api/ExtensionCore_api.gml"
    },
    "wrappers": {
      "outputFile": "../../../scripts/GMFirebaseAppCheck_API/GMFirebaseAppCheck_API.gml"
    },
    "extension": {
      "mode": "patch",
      "outputFile": "../../../extensions/GMFirebaseAppCheck/GMFirebaseAppCheck.yy"
    },
    "injectors": {}
  },
  "targets": {
    "windows": {},
    "macos": {},
    "linux": {},
    "android": {
      "mode": "jni"
    },
    "ios": {
      "mode": "native"
    }
  },
  "extras": {
    "docs": {
      "outputFile": "../../../../../docs/extgen_docs.js"
    }
  },
  "build": {
    "emitCmake": true,
    "cmake": {
      "cppStandard": 17,
      "cppExtensions": false,
      "strictWarnings": true,
      "useThirdParty": true,
      "emitPresets": true
    }
  }
}