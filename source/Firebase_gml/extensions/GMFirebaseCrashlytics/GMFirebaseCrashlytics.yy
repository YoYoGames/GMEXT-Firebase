  "ioscodeinjection": "\u003CYYIosPlist\u003E\r\n\r\n    \u003CtoExpand condition=\u0027${YYEXTOPT_GMFirebaseCrashlytics_disableDataCollection}\u0027\u003E\r\n        \u003Ckey\u003EFirebaseCrashlyticsCollectionEnabled\u003C/key\u003E\r\n        \u003Cfalse/\u003E\r\n    \u003C/toExpand\u003E\r\n\r\n\u003C/YYIosPlist\u003E\r\n\r\n\r\n\u003CYYIosCocoaPods\u003E\r\n\r\n    pod \u0027FirebaseCrashlytics\u0027, \u002712.19.0\u0027\r\n\r\n\u003C/YYIosCocoaPods\u003E\r\n\r\n\r\n\u003CYYIosScriptPhase\u003E\r\n\r\n    \u0022${PODS_ROOT}/FirebaseCrashlytics/run\u0022\r\n\r\n\u003C/YYIosScriptPhase\u003E\r\n\r\n\r\n\u003CYYIosBuildSettingsInjection\u003E\r\n\r\n    DEBUG_INFORMATION_FORMAT = \u0022dwarf-with-dsym\u0022;\r\n\r\n\u003C/YYIosBuildSettingsInjection\u003E\r\n",
