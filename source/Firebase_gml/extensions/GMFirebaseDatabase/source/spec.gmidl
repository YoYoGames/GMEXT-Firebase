[gml_api]
module GMFirebaseDatabase;

// Split from the working monolithic GMFirebase specification.
// Public function names are intentionally preserved.
// Generated code_gen files are NOT included; run Extension Generator for this module.

// ============================================================
// Realtime Database - enums
// ============================================================

// Mirrors firebase::LogLevel (firebase/log.h). Shared conceptually with
// Analytics' desktop log callback (which surfaces log_level as a plain
// `real`, not this enum, since it predates this declaration) - if another
// module ever needs a typed log level, reuse this one rather than declaring
// a second FirebaseLogLevel.
[global, bind = typed_gml]
enum FirebaseLogLevel
{
	Verbose = 0,
	Debug = 1,
	Info = 2,
	Warning = 3,
	Error = 4,
	Assert = 5,
}

// Mirrors firebase::database::Error (firebase/database/common.h). Every
// Database callback below that reports an error_code returns one of these
// values as a plain `real` (same convention as the rest of this extension -
// there is no single unified Firebase result enum to bind to), this enum
// exists purely so GML code can use named constants instead of magic numbers.
[global, bind = typed_gml]
enum FirebaseDatabaseError
{
	None = 0,
	Disconnected = 1,
	ExpiredToken = 2,
	InvalidToken = 3,
	MaxRetries = 4,
	NetworkError = 5,
	OperationFailed = 6,
	OverriddenBySet = 7,
	PermissionDenied = 8,
	Unavailable = 9,
	UnknownError = 10,
	WriteCanceled = 11,
	InvalidVariantType = 12,
	ConflictingOperationInProgress = 13,
	TransactionAbortedByUser = 14,
}

// ============================================================
// Realtime Database - Database
// ============================================================
// A Database* is SDK-owned and never deleted by this extension (matching
// Database::GetInstance()'s documented lifetime - it lives as long as the
// App), so there is deliberately no firebase_database_release().

// Uses the default App's default-URL database.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_get_instance(): gmval;

// Uses the default App against a specific database URL (for apps with more
// than one Realtime Database instance).
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_get_instance_for_url(
	url: string
): gmval;

[global, bind = typed_gml]
function firebase_database_get_url(
	[type_hint=`uint64`] db_ref: gmval
): string;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_get_reference(
	[type_hint=`uint64`] db_ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_get_reference_at_path(
	[type_hint=`uint64`] db_ref: gmval,
	path: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_get_reference_from_url(
	[type_hint=`uint64`] db_ref: gmval,
	url: string
): gmval;

[global, bind = typed_gml]
function firebase_database_go_offline(
	[type_hint=`uint64`] db_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_go_online(
	[type_hint=`uint64`] db_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_purge_outstanding_writes(
	[type_hint=`uint64`] db_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_set_persistence_enabled(
	[type_hint=`uint64`] db_ref: gmval,
	enabled: real
): real;

[global, bind = typed_gml]
function firebase_database_set_log_level(
	[type_hint=`uint64`] db_ref: gmval,
	[type_hint=`FirebaseLogLevel`] log_level: gmval
): real;

[global, bind = typed_gml, type_hint=`FirebaseLogLevel`]
function firebase_database_get_log_level(
	[type_hint=`uint64`] db_ref: gmval
): gmval;

// ============================================================
// Realtime Database - Query surface
// ============================================================
// DatabaseReference IS-A Query in the underlying SDK, but the two are kept
// as separate ref families here: a GM_FB_TYPE_DATABASE_REF handle (minted by
// Database.GetReference*/DatabaseReference.Child|Push|Parent|Root) is only
// ever accepted by firebase_database_ref_*, and a GM_FB_TYPE_DATABASE_QUERY
// handle (minted by any OrderBy*/StartAt/EndAt/EqualTo/LimitTo* call below,
// on either family) is only ever accepted by firebase_database_query_*.
// Every OrderBy*/StartAt/EndAt/EqualTo/LimitTo* call, on either family,
// always returns a *_query ref, never a *_ref one - the result has lost
// DatabaseReference-only capabilities (Child/Push/SetValue/...) regardless
// of which family it started from. Call firebase_database_query_get_reference
// to recover a plain DatabaseReference (with the ordering/filtering stripped
// off) from either family.
//
// order_value/child_key mirror StartAt/EndAt/EqualTo's Variant+optional key
// overloads: order_value accepts a real, string, or bool (matching the
// subset of Variant types those SDK calls document as valid for ordering).

// ---- firebase_database_ref_* ----

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_order_by_child(
	[type_hint=`uint64`] ref: gmval,
	path: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_order_by_key(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_order_by_value(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_order_by_priority(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_start_at(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_start_at_key(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval,
	child_key: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_end_at(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_end_at_key(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval,
	child_key: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_equal_to(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_equal_to_key(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval,
	child_key: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_limit_to_first(
	[type_hint=`uint64`] ref: gmval,
	limit: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_limit_to_last(
	[type_hint=`uint64`] ref: gmval,
	limit: real
): gmval;

[global, bind = typed_gml]
function firebase_database_ref_set_keep_synchronized(
	[type_hint=`uint64`] ref: gmval,
	keep_sync: real
): real;

// callback(error_code: real, error_message: string, snapshot_ref: uint64)
[global, bind = typed_gml]
function firebase_database_ref_get_value(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// on_value_changed(snapshot_ref: uint64)
// on_cancelled(error_code: real, error_message: string)
// Returns a value-listener handle for firebase_database_ref_remove_value_listener.
// Value and child listeners use distinct encoded handle type codes, so mixing
// them is rejected safely.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_add_value_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] on_value_changed: gmval,
	[type_hint=`func?`] on_cancelled: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_ref_remove_value_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`uint64`] listener_ref: gmval
): real;

// Detaches every value listener from this query with the SDK, but does not
// (cannot) free the GMFirebaseValueListener heap instances behind refs GML
// is still holding - call remove_value_listener on each of those separately.
[global, bind = typed_gml]
function firebase_database_ref_remove_all_value_listeners(
	[type_hint=`uint64`] ref: gmval
): real;

// on_child_added/changed/moved(snapshot_ref: uint64, previous_sibling_key: string)
// on_child_removed(snapshot_ref: uint64)
// on_cancelled(error_code: real, error_message: string)
// Returns a child-listener handle for firebase_database_ref_remove_child_listener.
// It is intentionally a different encoded type from a value-listener handle.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_add_child_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] on_child_added: gmval,
	[type_hint=`func?`] on_child_changed: gmval,
	[type_hint=`func?`] on_child_moved: gmval,
	[type_hint=`func?`] on_child_removed: gmval,
	[type_hint=`func?`] on_cancelled: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_ref_remove_child_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`uint64`] listener_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_ref_remove_all_child_listeners(
	[type_hint=`uint64`] ref: gmval
): real;

// ---- firebase_database_query_* (identical surface, operating on a
// GM_FB_TYPE_DATABASE_QUERY handle instead) ----

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_order_by_child(
	[type_hint=`uint64`] ref: gmval,
	path: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_order_by_key(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_order_by_value(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_order_by_priority(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_start_at(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_start_at_key(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval,
	child_key: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_end_at(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_end_at_key(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval,
	child_key: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_equal_to(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_equal_to_key(
	[type_hint=`uint64`] ref: gmval,
	order_value: gmval,
	child_key: string
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_limit_to_first(
	[type_hint=`uint64`] ref: gmval,
	limit: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_limit_to_last(
	[type_hint=`uint64`] ref: gmval,
	limit: real
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_get_reference(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_query_set_keep_synchronized(
	[type_hint=`uint64`] ref: gmval,
	keep_sync: real
): real;

[global, bind = typed_gml]
function firebase_database_query_is_valid(
	[type_hint=`uint64`] ref: gmval
): real;

// callback(error_code: real, error_message: string, snapshot_ref: uint64)
[global, bind = typed_gml]
function firebase_database_query_get_value(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_add_value_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] on_value_changed: gmval,
	[type_hint=`func?`] on_cancelled: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_query_remove_value_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`uint64`] listener_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_query_remove_all_value_listeners(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_query_add_child_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] on_child_added: gmval,
	[type_hint=`func?`] on_child_changed: gmval,
	[type_hint=`func?`] on_child_moved: gmval,
	[type_hint=`func?`] on_child_removed: gmval,
	[type_hint=`func?`] on_cancelled: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_query_remove_child_listener(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`uint64`] listener_ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_query_remove_all_child_listeners(
	[type_hint=`uint64`] ref: gmval
): real;

// Frees the value-copy registry slot for a *_query ref. Does not touch the
// SDK query object itself (Query has no explicit close/dispose) and does not
// affect any listener refs still outstanding against it.
[global, bind = typed_gml]
function firebase_database_query_release(
	[type_hint=`uint64`] ref: gmval
): real;

// ============================================================
// Realtime Database - DatabaseReference-only surface
// ============================================================

// Explicit convenience materialization for a DatabaseReference. This allocates
// one GML struct and registers the returned reference/parent/root handles, so
// prefer the granular getters on frame-sensitive paths. It collects key,
// identity flags, and the *_ref/*_url values that used to need five separate
// round trips (get_reference/get_parent/get_root/get_database/get_url).
// `reference`, `parent`, and `root` are newly registered GM_FB_TYPE_DATABASE_REF
// refs owned by the caller - release them with firebase_database_ref_release()
// when done. `database` is a GM_FB_TYPE_DATABASE ref (not owned/released,
// same as every other Database-returning getter in this extension).
[global]
class `[[FirebaseDatabaseReferenceInfo]]` prototype Object
{
	[field] property key: string { get; set; }
	[field] property is_root: bool { get; set; }
	[field] property is_valid: bool { get; set; }
	[field, type_hint=`uint64`] property reference: gmval { get; set; }
	[field, type_hint=`uint64`] property parent: gmval { get; set; }
	[field, type_hint=`uint64`] property root: gmval { get; set; }
	[field, type_hint=`uint64`] property database: gmval { get; set; }
	[field] property url: string { get; set; }
}

// Consolidates firebase_database_ref_key/is_root/is_valid/get_reference/
// get_parent/get_root/get_database/get_url into a single call. If `ref` is
// not a valid registered DatabaseReference, returns a default-constructed
// struct (key "", is_root/is_valid false, reference/parent/root/database 0,
// url "") - same convention as firebase_database_snapshot_get_info().
[global, bind = typed_gml, type_hint=`FirebaseDatabaseReferenceInfo`]
function firebase_database_ref_get(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_child(
	[type_hint=`uint64`] ref: gmval,
	path: string
): gmval;

// Appends a new auto-generated, chronologically-ordered child key (Firebase
// "push ID") and returns a ref to it - the SDK does not write any value at
// that location, callers still need a follow-up set_value.
[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_ref_push(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_ref_go_online(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_ref_go_offline(
	[type_hint=`uint64`] ref: gmval
): real;

// value: real|string|bool|array|struct (converted through the same
// firebase::Variant mapping described in GMFirebase_common.h).
// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_database_ref_set_value(
	[type_hint=`uint64`] ref: gmval,
	value: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_database_ref_set_priority(
	[type_hint=`uint64`] ref: gmval,
	priority: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_database_ref_set_value_and_priority(
	[type_hint=`uint64`] ref: gmval,
	value: gmval,
	priority: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// values: struct mapping child paths to the value each should be set to
// (Firebase's own UpdateChildren semantics - a multi-location patch update).
// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_database_ref_update_children(
	[type_hint=`uint64`] ref: gmval,
	values: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_database_ref_remove_value(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// Intentional limitation - reports FirebaseDatabaseError.TransactionAbortedByUser until a safe synchronous GML transaction bridge exists.
//
// firebase::database::DatabaseReference::RunTransaction() invokes its
// DoTransaction handler synchronously - possibly multiple times, retrying on
// optimistic-concurrency conflicts - directly on the Realtime Database SDK's
// own internal run-loop thread, and that handler must return a
// TransactionResult (commit/abort) before RunTransaction() itself returns.
// Every other async SDK call in this extension crosses the wire by firing a
// GMFunction callback once, from whichever thread the SDK completes it on,
// with no reply expected back - that fire-and-forget shape cannot express
// "pause the SDK thread and block until GML answers with a MutableData
// mutation," and attempting it risks deadlocking against the same
// DispatchQueue/step-loop machinery the reply would need to arrive through.
// Implementing this for real would need a from-scratch synchronous
// mid-transaction round trip (or a queued-retry emulation built on top of
// get_value+set_value) that cannot be represented safely by the current asynchronous GMFunction bridge.
// callback(error_code: real, error_message: string, snapshot_ref: uint64) -
// snapshot_ref is always 0.
[global, bind = typed_gml]
function firebase_database_ref_run_transaction(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// Frees the value-copy registry slot for a *_ref handle. Does not touch the
// underlying database location.
[global, bind = typed_gml]
function firebase_database_ref_release(
	[type_hint=`uint64`] ref: gmval
): real;

// ============================================================
// Realtime Database - DataSnapshot
// ============================================================

// Explicit convenience materialization for snapshot metadata. This allocates
// one GML struct; hot listener paths should use the individual snapshot
// getters when only one or two fields are needed. It contains everything
// about a snapshot EXCEPT its (dynamically-typed) value/priority -
// fetch those separately via firebase_database_snapshot_get_value()/
// get_priority(). `reference` is a newly registered GM_FB_TYPE_DATABASE_REF
// ref owned by the caller - release it with firebase_database_ref_release()
// when done.
[global]
class `[[FirebaseDataSnapshotInfo]]` prototype Object
{
	[field] property key: string { get; set; }
	[field] property exists: bool { get; set; }
	[field] property is_valid: bool { get; set; }
	[field] property has_children: bool { get; set; }
	[field, type_hint=`real`] property children_count: gmval { get; set; }
	[field, type_hint=`uint64`] property reference: gmval { get; set; }
}

[global, bind = typed_gml]
function firebase_database_snapshot_exists(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_snapshot_is_valid(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_snapshot_child(
	[type_hint=`uint64`] ref: gmval,
	path: string
): gmval;

[global, bind = typed_gml]
function firebase_database_snapshot_has_child(
	[type_hint=`uint64`] ref: gmval,
	path: string
): real;

[global, bind = typed_gml]
function firebase_database_snapshot_has_children(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml]
function firebase_database_snapshot_children_count(
	[type_hint=`uint64`] ref: gmval
): real;

// Returns an array of uint64 snapshot refs, one per child, in the snapshot's
// Query-defined iteration order. Each element is an independently owned
// GM_FB_TYPE_DATA_SNAPSHOT ref and must be released separately with
// firebase_database_snapshot_release().
[global, bind = typed_gml]
function firebase_database_snapshot_get_children(
	[type_hint=`uint64`] ref: gmval
): gmval;

[global, bind = typed_gml]
function firebase_database_snapshot_key(
	[type_hint=`uint64`] ref: gmval
): string;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_database_snapshot_get_reference(
	[type_hint=`uint64`] ref: gmval
): gmval;

// Returns everything about the snapshot at this location - except its value/
// priority, see get_value()/get_priority() below - as a FirebaseDataSnapshotInfo
// struct. If `ref` is not a valid registered snapshot, returns a
// default-constructed struct (key "", exists/is_valid/has_children false,
// children_count 0, reference 0) - same convention as
// firebase_remote_config_get_info().
[global, bind = typed_gml, type_hint=`FirebaseDataSnapshotInfo`]
function firebase_database_snapshot_get_info(
	[type_hint=`uint64`] snapshot: gmval
): gmval;

// Materializes ONLY the dynamically-typed value at this location
// (undefined/bool/real/string/array/struct, arbitrarily nested). The snapshot
// itself remains the uint64 handle, so merely receiving/passing a snapshot
// through a listener does not allocate a GameMaker struct.
[global, bind = typed_gml]
function firebase_database_snapshot_get_value(
	[type_hint=`uint64`] snapshot: gmval
): gmval;

// Same convention as get_value(), applied to the snapshot's priority instead
// (also a dynamically-typed Firebase value - usually real, string, or
// undefined).
[global, bind = typed_gml]
