{
  "$GMExtension": "v1",
  "%Name": "GMFirebaseInAppMessaging",
  "androidactivityinject": null,
  "androidclassname": "GMFirebaseInAppMessaging",
  "androidcodeinjection": "\u003CYYAndroidGradleDependencies\u003E\r\n\r\n    // The main GMFirebase extension already supplies:\r\n    // - the Firebase BoM\r\n    // - Firebase Analytics\r\n    //\r\n    // The Display artifact includes FIAM\u0027s headless SDK transitively.\r\n    implementation \u0027com.google.firebase:firebase-inappmessaging-display\u0027\r\n\r\n\u003C/YYAndroidGradleDependencies\u003E\r\n\r\n\r\n\u003CYYAndroidManifestApplicationInject\u003E\r\n\r\n    \u003CtoExpand condition=\u0027${YYEXTOPT_GMFirebaseInAppMessaging_disableDataCollection}\u0027\u003E\r\n        \u003Cmeta-data\r\n            android:name=\u0022firebase_inapp_messaging_auto_data_collection_enabled\u0022\r\n            android:value=\u0022false\u0022 /\u003E\r\n    \u003C/toExpand\u003E\r\n\r\n\u003C/YYAndroidManifestApplicationInject\u003E\r\n",
  "androidinject": null,
  "androidmanifestinject": null,
  "androidPermissions": [],
  "androidProps": true,
  "androidsourcedir": "",
  "author": "",
  "classname": "GMFirebaseInAppMessaging",
  "copyToTargets": 12,
  "description": "Firebase In-App Messaging for Android and iOS. Requires the GMFirebase extension in the same project: it supplies the Firebase BoM, the google-services plugin and the credentials on Android, and firebase_app_initialize() configures the default app on iOS.",
  "exportToGame": true,
  "extensionVersion": "3.1.0",
