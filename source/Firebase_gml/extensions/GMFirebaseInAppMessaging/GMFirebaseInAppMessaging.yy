  "ioscodeinjection": "\u003CYYIosCocoaPods\u003E\r\n\r\n    # Keep the same Firebase Apple version as the rest of GMFirebase.\r\npod \u0027FirebaseInAppMessaging\u0027, \u002712.19.0-beta\u0027\r\n\r\n\u003C/YYIosCocoaPods\u003E\r\n\r\n\r\n\u003CYYIosPlist\u003E\r\n\r\n    \u003CtoExpand condition=\u0027${YYEXTOPT_GMFirebaseInAppMessaging_disableDataCollection}\u0027\u003E\r\n        \u003Ckey\u003EFirebaseInAppMessagingAutomaticDataCollectionEnabled\u003C/key\u003E\r\n        \u003Cfalse/\u003E\r\n    \u003C/toExpand\u003E\r\n\r\n\u003C/YYIosPlist\u003E\r\n",
