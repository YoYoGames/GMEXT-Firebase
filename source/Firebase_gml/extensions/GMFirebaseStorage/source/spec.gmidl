[global, bind = typed_gml]
function firebase_storage_ref_bucket(
	[type_hint=`uint64`] ref: gmval
): string;

[global, bind = typed_gml]
function firebase_storage_ref_full_path(
	[type_hint=`uint64`] ref: gmval
): string;

[global, bind = typed_gml]
function firebase_storage_ref_name(
	[type_hint=`uint64`] ref: gmval
): string;

[global, bind = typed_gml]
function firebase_storage_ref_is_valid(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_storage_ref_storage(
	[type_hint=`uint64`] ref: gmval
): gmval;

// callback(error_code: real, error_message: string)
[global, bind = typed_gml]
function firebase_storage_ref_delete(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, url: string)
[global, bind = typed_gml]
function firebase_storage_ref_get_download_url(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, metadata_ref: uint64)
[global, bind = typed_gml]
function firebase_storage_ref_get_metadata(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, metadata_ref: uint64)
[global, bind = typed_gml]
function firebase_storage_ref_update_metadata(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=`uint64`] metadata_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// metadata_ref/controller_ref: pass 0 for "not provided" - controller_ref
// must come from storage_controller_create() if you want to pause/resume/
// cancel or poll progress mid-transfer.
// progress_callback(paused: bool, bytes_transferred: real, total_byte_count: real)
// callback(error_code: real, error_message: string, metadata_ref: uint64)
[global, bind = typed_gml]
function firebase_storage_ref_put_bytes(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=buffer] data: gmval,
	[type_hint=`uint64`] metadata_ref: gmval,
	[type_hint=`func?`] progress_callback: gmval,
	[type_hint=`uint64`] controller_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// See storage_ref_put_bytes for metadata_ref/controller_ref/callback shapes.
[global, bind = typed_gml]
function firebase_storage_ref_put_file(
	[type_hint=`uint64`] ref: gmval,
	local_path: string,
	[type_hint=`uint64`] metadata_ref: gmval,
	[type_hint=`func?`] progress_callback: gmval,
	[type_hint=`uint64`] controller_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// data: a GML buffer pre-sized to the maximum number of bytes to download;
// the SDK writes directly into it. controller_ref: pass 0 for "not
// provided". progress_callback(paused: bool, bytes_transferred: real, total_byte_count: real)
// callback(error_code: real, error_message: string, bytes_read: real)
[global, bind = typed_gml]
function firebase_storage_ref_get_bytes(
	[type_hint=`uint64`] ref: gmval,
	[type_hint=buffer] data: gmval,
	[type_hint=`func?`] progress_callback: gmval,
	[type_hint=`uint64`] controller_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// callback(error_code: real, error_message: string, bytes_read: real)
[global, bind = typed_gml]
function firebase_storage_ref_get_file(
	[type_hint=`uint64`] ref: gmval,
	local_path: string,
	[type_hint=`func?`] progress_callback: gmval,
	[type_hint=`uint64`] controller_ref: gmval,
	[type_hint=`func?`] callback: gmval
): real;

// page_token: pass "" for the first page.
// callback(error_code: real, error_message: string, list_result_ref: uint64)
[global, bind = typed_gml]
function firebase_storage_ref_list(
	[type_hint=`uint64`] ref: gmval,
	max_results: real,
	page_token: string,
	[type_hint=`func?`] callback: gmval
): real;

