// ---- Controller ----
// Must be created via storage_controller_create() before being passed as an
// optional controller_ref to a Put*/Get* call above, so its map-stable
// address is ready to hand the SDK as the out-param it polls during the
// transfer.

[global, bind = typed_gml, type_hint=`uint64`]
function firebase_storage_controller_create(): gmval;

[global, bind = typed_gml]
function firebase_storage_controller_release(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml]
function firebase_storage_controller_is_valid(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml]
function firebase_storage_controller_pause(
	[type_hint=`uint64`] ref: gmval
): real;

[global, bind = typed_gml]
