
var _trace = obj_firebase_performance.trace

if (_trace != 0)
{
    firebase_performance_trace_put_attribute(
        _trace,
        "mode",
        "ranked"
    );

    firebase_performance_trace_put_attribute(
        _trace,
        "map",
        "arena_01"
    );
}


firebase_performance_trace_put_attribute(
    _trace,
    "connection",
    "wifi"
);

